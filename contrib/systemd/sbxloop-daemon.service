[Unit]
Description=sbxloop daemon — autonomous outer loop over labeled issues and inbox files
Documentation=https://github.com/brettbergin/sbxloop
After=network-online.target
Wants=network-online.target
# Restart rate limiting is a [Unit] setting (under [Service] systemd ignores it).
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
# The project directory: sbxloop.toml, .env (COPILOT_GITHUB_TOKEN, GH_TOKEN,
# DISCORD_BOT_TOKEN) and the inbox live here; run state goes to
# ~/.local/state/sbxloop/<this dir's name>/ unless [daemon] state_dir says
# otherwise. Tokens are loaded from .env by sbxloop itself, so no
# EnvironmentFile is needed.
WorkingDirectory=%h/sbxloop-runner
ExecStart=%h/.local/bin/sbxloop daemon
Restart=always
RestartSec=30
# Must exceed [daemon].shutdown_grace_s (default 60) plus sandbox teardown.
# An interrupted run is resumable by design; the daemon recovers it on the
# next start, so a long stop wait buys nothing.
TimeoutStopSec=120
KillMode=mixed
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target

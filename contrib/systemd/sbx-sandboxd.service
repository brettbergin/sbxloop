[Unit]
Description=Docker Sandboxes daemon (sandboxd) — sbxloop's sandbox backend
Documentation=https://docs.docker.com/ai/sandboxes/
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
# `sbx daemon start` stays in the foreground (-d/--detach is what backgrounds
# it), so Type=simple is right. Run it through the ~/.local/bin/sbx wrapper if
# you have one: sandboxd's "block" volume driver shells out to mkfs.ext4, which
# is not on the default non-root PATH on Debian — without /usr/sbin:/sbin the
# only symptom is "unknown volume driver: block".
ExecStart=%h/.local/bin/sbx daemon start
ExecStop=%h/.local/bin/sbx daemon stop
Restart=always
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=default.target

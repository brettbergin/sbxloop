# sbxloop environment — copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored and loaded automatically by the sbxloop CLI and
# LoopEngine from the current working directory. Real environment variables
# always take precedence over values defined here.

# ── Required credentials ────────────────────────────────────────────────────

# Fine-grained GitHub PAT with the "Copilot Requests" permission.
# Injected ONLY into the agent sandbox (proxy-bound to the Copilot API hosts).
# Create at: https://github.com/settings/personal-access-tokens
COPILOT_GITHUB_TOKEN=

# Fine-grained GitHub PAT with the repository permissions sbxloop should act
# with (e.g. Issues: read/write, Contents: read, Pull requests: read/write).
# Injected ONLY into the github-ops sandbox.
GH_TOKEN=

# ── Optional settings (override sbxloop.toml / pyproject [tool.sbxloop]) ────

# Copilot model for agent sessions ("auto" lets the SDK choose).
#SBXLOOP_MODEL=auto

# Keep sandboxes around after a run, for debugging.
#SBXLOOP_KEEP_SANDBOXES=false

# The GitHub integration: the ONE repository sbxloop may work with.
# Unset disables GitHub entirely (no github sandbox, no GH_TOKEN needed).
#SBXLOOP_GITHUB__REPO=owner/repo
# With a repo set every run lands its own draft PR: review, fix rounds, CI,
# merge — knobs under [landing], e.g.
#SBXLOOP_LANDING__MAX_REVIEW_ROUNDS=3

# Budgets (see docs/architecture.md).
#SBXLOOP_BUDGETS__MAX_TASKS=20
#SBXLOOP_BUDGETS__MAX_WALL_CLOCK_S=7200

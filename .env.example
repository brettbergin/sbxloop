# sbxloop secrets — the shape of ~/.sbxloop/config/secrets.env.
#
# `sbxloop init` writes this template there (mode 0600); fill it in. Every
# sbxloop command loads that one file; real environment variables always
# take precedence over values defined in it. Secrets live THERE, never in
# sbxloop.toml, and never in a working-directory .env — a checkout's .env
# belongs to the application in it and is not read.

# ── Required credentials ────────────────────────────────────────────────────
#
# The agent credential: ONE of the two below, chosen by [agent] backend in
# sbxloop.toml. It is injected only into the agent sandbox (never a GitHub
# token there), it is what the chat concierge needs on the daemon host, and
# `sbxloop doctor` / `secrets` / `list-models` all check the one the
# configured backend names.

# [agent] backend = "copilot" (the default): fine-grained GitHub PAT with the
# "Copilot Requests" permission, proxy-bound to the Copilot API hosts.
# Create at: https://github.com/settings/personal-access-tokens
COPILOT_GITHUB_TOKEN=

# [agent] backend = "claude": Anthropic API key, bound to
# api.anthropic.com.
# Create at: https://console.anthropic.com/settings/keys
#ANTHROPIC_API_KEY=

# Fine-grained GitHub PAT with the repository permissions sbxloop acts with
# — the table in docs/permissions.md (Contents, Pull requests and Issues
# read/write; Checks and Actions read). Injected ONLY into the github-ops
# sandbox; `sbxloop doctor --probe` checks it against that table.
GH_TOKEN=
# GITHUB_TOKEN is accepted as an alias: sbxloop reads GH_TOKEN first and falls
# back to GITHUB_TOKEN, and exports both inside the github-ops sandbox.
#GITHUB_TOKEN=

# ── GitHub App auth (alternative to GH_TOKEN) ───────────────────────────────
#
# Instead of a PAT, sbxloop can authenticate as a GitHub App installation:
# the host mints short-lived installation tokens — attributed on
# GitHub to the app, auto-refreshed before they expire — and only those
# tokens ever enter the github-ops sandbox; the private key never leaves
# the host. Set ALL of app id + installation id + private key, and leave
# GH_TOKEN/GITHUB_TOKEN unset: both credential sets at once (or a partial
# App set) is a named startup error, never a late 401.
#GITHUB_APP_ID=
#GITHUB_APP_INSTALLATION_ID=
# Exactly one of: the path to the .pem file GitHub generated for the app,
# or the PEM itself inline (quoted, multi-line values work in .env).
#GITHUB_APP_PRIVATE_KEY_PATH=
#GITHUB_APP_PRIVATE_KEY=

# ── Chat backend for `sbxloop daemon` (one of the two; [chat] in sbxloop.toml) ──

# Discord gateway bot token for the chronology/steering bridge and the
# concierge. Read from the environment / .env only — never from sbxloop.toml,
# never logged. Needed only when [discord] channel_id is set.
#DISCORD_BOT_TOKEN=

# Slack: the bot token (xoxb-…, the Web API) and the app-level token (xapp-…,
# Socket Mode; scope connections:write) of your Slack app. Same rules: env /
# .env only, never sbxloop.toml, never logged. Needed only when [slack]
# channel_id is set.
#SLACK_BOT_TOKEN=
#SLACK_APP_TOKEN=

# ── Per-repository tokens ───────────────────────────────────────────────────

# A [[github.repos]] entry may name its own token variable with
# `token_env = "GH_TOKEN_TWO"`; unset, that repository uses GH_TOKEN above.
# Name one variable per repository that needs distinct credentials.
#GH_TOKEN_TWO=

# ── Optional settings (override sbxloop.toml / pyproject [tool.sbxloop]) ────
#
# Any config key is settable as SBXLOOP_<SECTION>__<KEY> (double underscore
# between section and key); values parse as TOML scalars. A few common ones:

# Copilot model for agent sessions ("auto" lets the SDK choose).
#SBXLOOP_MODEL=auto

# Keep sandboxes around after a run, for debugging.
#SBXLOOP_KEEP_SANDBOXES=false

# The sbxloop home — runs, state, workspaces, logs, config. Not a config
# key: it moves the whole tree, this file included, so it can only come
# from the real environment (a shell export, the unit's Environment=).
# SBXLOOP_HOME=~/.sbxloop

# LEGACY: the single-repository form. Prefer [[github.repos]] in
# sbxloop.toml, which the env layer cannot express; kept only for
# single-repo setups that predate multi-repo.
#SBXLOOP_GITHUB__REPO=you/your-repo

# With a repo set every run lands its own draft PR: review, fix rounds, CI,
# merge — knobs under [landing], e.g.
#SBXLOOP_LANDING__MAX_REVIEW_ROUNDS=3

# Budgets (see docs/architecture.md).
#SBXLOOP_BUDGETS__MAX_TASKS=20
#SBXLOOP_BUDGETS__MAX_WALL_CLOCK_S=7200

# Daemon knobs, e.g. the issue label that queues work and its log stream.
#SBXLOOP_DAEMON__TRIGGER_LABEL=sbxloop:run
#SBXLOOP_DAEMON__LOG_LEVEL=INFO

# ── Where this lives ────────────────────────────────────────────────────────
#
# One place on every host, developer machine or daemon host alike:
#
#     ~/.sbxloop/config/secrets.env      (mode 0600, owned by the user)
#
# sbxloop reads it itself at startup; nothing exports its contents to other
# processes. This committed example holds the shape only — the real file
# holds real tokens and is never committed. SBXLOOP_HOME moves the home.
